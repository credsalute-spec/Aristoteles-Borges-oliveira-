@app.post("/token")
def login_for_token(owner_id: str = Body(..., embed=True)):
    token = create_access_token({"sub": owner_id, "owner_id": owner_id})
    return {"access_token": token, "token_type": "bearer"}

@app.post("/avatars", response_model=Dict[str, Any])
async def create_avatar(payload: CreateAvatarRequest, user: dict = Depends(get_current_user)):
    if payload.owner_id != user.get("owner_id") and payload.owner_id != user.get("sub"):
        raise HTTPException(status_code=403, detail="Owner mismatch")
    avatar_id = f"{payload.owner_id}-{uuid.uuid4().hex[:8]}"
    with Session(engine) as session:
        avatar = Avatar(
            avatar_id=avatar_id,
            owner_id=payload.owner_id,
            identity_profile=payload.identity_profile.dict(),
            persona_traits=payload.persona_traits.dict() if payload.persona_traits else {},
            status="draft",
            metadata={"created_at": datetime.utcnow().isoformat(), "version": 1}
        )
        session.add(avatar)
        session.commit()
        session.refresh(avatar)
    raw_texts = []
    if payload.identity_profile.bio:
        raw_texts.append(payload.identity_profile.bio)
    asyncio.create_task(persona_compiler.compile(avatar_id, raw_texts))
    return {"avatar_id": avatar_id, "status": "created"}

@app.post("/avatars/{avatar_id}/import-log", response_model=ImportLogResponse)
async def import_log(avatar_id: str, file: UploadFile = File(...), file_format: str = Body("text", embed=True), user: dict = Depends(get_current_user)):
    with Session(engine) as session:
        stmt = select(Avatar).where(Avatar.avatar_id == avatar_id)
        avatar = session.exec(stmt).first()
        if not avatar:
            raise HTTPException(status_code=404, detail="Avatar not found")
        if avatar.owner_id != user.get("owner_id") and avatar.owner_id != user.get("sub"):
            raise HTTPException(status_code=403, detail="Not owner")
    content = await file.read()
    entry = await memory_service.append_entry(avatar_id, content, source=f"import:{file.filename}")
    text_preview = content.decode("utf-8", errors="ignore")[:4096]
    asyncio.create_task(persona_compiler.compile(avatar_id, [text_preview]))
    return ImportLogResponse(detail=f"import started, entry_id={entry['id']}")

