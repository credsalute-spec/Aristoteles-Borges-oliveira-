# ---------------------------
# DB model
# ---------------------------
class Avatar(SQLModel, table=True):
    id: Optional[int] = ORMField(default=None, primary_key=True)
    avatar_id: str = ORMField(index=True, nullable=False)
    owner_id: str = ORMField(index=True, nullable=False)
    status: str = ORMField(default="draft")
    metadata: Dict[str, Any] = ORMField(default={})
    identity_profile: Dict[str, Any] = ORMField(default={})
    persona_traits: Dict[str, Any] = ORMField(default={})
    created_at: datetime = ORMField(default_factory=datetime.utcnow)
    updated_at: datetime = ORMField(default_factory=datetime.utcnow)

# ---------------------------
# Pydantic schemas
# ---------------------------
class IdentityProfile(BaseModel):
    display_name: str
    legal_name: Optional[str] = None
    age_range: Optional[str] = None
    pronouns: Optional[str] = None
    bio: Optional[str] = None

class PersonaTraits(BaseModel):
    traits_vector_id: Optional[str] = None
    traits: Optional[Dict[str, float]] = None

class CreateAvatarRequest(BaseModel):
    owner_id: str
    identity_profile: IdentityProfile
    persona_traits: Optional[PersonaTraits] = None

class ImportLogResponse(BaseModel):
    detail: str

class ActivateResponse(BaseModel):
    avatar_id: str
    status: str

