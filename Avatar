@app.get("/avatars/{avatar_id}/export")
async def export_avatar(avatar_id: str, user: dict = Depends(get_current_user)):
    with Session(engine) as session:
        stmt = select(Avatar).where(Avatar.avatar_id == avatar_id)
        avatar = session.exec(stmt).first()
        if not avatar:
            raise HTTPException(status_code=404, detail="Avatar not found")
        if avatar.owner_id != user.get("owner_id") and avatar.owner_id != user.get("sub"):
            raise HTTPException(status_code=403, detail="Not owner")
    bundle = {
        "avatar": {
            "avatar_id": avatar.avatar_id,
            "owner_id": avatar.owner_id,
            "identity_profile": avatar.identity_profile,
            "persona_traits": avatar.persona_traits,
            "metadata": avatar.metadata
        },
        "exported_at": datetime.utcnow().isoformat()
    }
    encrypted = kms.encrypt(key_id="default", plaintext=str(bundle).encode("utf-8"))
    key = f"{avatar_id}/exports/{uuid.uuid4().hex}.bin"
    ref = upload_to_s3(key, encrypted)
    return {"export_ref": ref}

