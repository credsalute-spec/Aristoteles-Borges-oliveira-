    await asyncio.sleep(0.1)
    snapshot = {"avatar_id": avatar_id, "snapshot_at": datetime.utcnow().isoformat()}
    key = f"{avatar_id}/snapshots/{uuid.uuid4().hex}.json"
    upload_to_s3(key, str(snapshot).encode("utf-8"))
