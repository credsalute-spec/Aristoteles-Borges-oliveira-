kms = KMSWrapper()

def upload_to_s3(key: str, content: bytes) -> str:
    try:
        s3 = boto3.client("s3", region_name=AWS_REGION)
        s3.put_object(Bucket=S3_BUCKET, Key=key, Body=content)
        return f"s3://{S3_BUCKET}/{key}"
    except Exception:
        # fallback placeholder path
        return f"s3://{S3_BUCKET}/{key}"

