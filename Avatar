@app.post("/avatars/{avatar_id}/activate", response_model=ActivateResponse)
async def activate_avatar(avatar_id: str, user: dict = Depends(get_current_user)):
    with Session(engine) as session:
        stmt = select(Avatar).where(Avatar.avatar_id == avatar_id)
        avatar = session.exec(stmt).first()
        if not avatar:
            raise HTTPException(status_code=404, detail="Avatar not found")
        if avatar.owner_id != user.get("owner_id") and avatar.owner_id != user.get("sub"):
            raise HTTPException(status_code=403, detail="Not owner")
        avatar.status = "active"
        avatar.updated_at = datetime.utcnow()
        avatar.metadata["activated_at"] = datetime.utcnow().isoformat()
        session.add(avatar)
        session.commit()
        session.refresh(avatar)
    asyncio.create_task(snapshot_avatar_task(avatar_id))
    return ActivateResponse(avatar_id=avatar_id, status="active")

