class PersonaCompiler:
    def __init__(self, vector_url: str = VECTOR_DB_URL):
        self.vector_url = vector_url

    async def compile(self, avatar_id: str, raw_texts: List[str]) -> Dict[str, Any]:
        embeddings = [{"id": str(uuid.uuid4()), "text": t} for t in raw_texts if t]
        if embeddings:
            await vector_upsert(avatar_id, embeddings)
        traits = {"openness": 0.5, "humor_level": 0.5}
        return {"status": "compiled", "traits": traits, "embeddings_count": len(embeddings)}

class MemoryService:
    def __init__(self):
        pass

    async def append_entry(self, avatar_id: str, content: bytes, source: str, confidentiality: str = "private"):
        entry_id = str(uuid.uuid4())
        key = f"{avatar_id}/memories/{entry_id}.bin"
        ref = upload_to_s3(key, content)
        text_preview = content.decode("utf-8", errors="ignore")[:2048]
        embeddings = [{"id": entry_id, "text": text_preview}]
        await vector_upsert(avatar_id, embeddings)
        return {"id": entry_id, "content_ref": ref, "timestamp": datetime.utcnow().isoformat(), "source": source, "confidentiality_level": confidentiality}

    async def semantic_search(self, avatar_id: str, query: str, top_k: int = 5):
        return await vector_search(avatar_id, query, top_k)

persona_compiler = PersonaCompiler()
memory_service = MemoryService()

